DATABASE_URL="postgresql://postgres:password@localhost:5432/asdc_diagnostic?schema=public"
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
BETTER_AUTH_URL="http://localhost:3000"

# Required only when bootstrapping the first admin account:
ADMIN_NAME="Administrator"
ADMIN_EMAIL="admin@example.com"

# Encrypts the SMTP password stored in the database. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMAIL_ENCRYPTION_KEY="…"
# During a key rotation, the previous key (so older values can still be read):
# EMAIL_ENCRYPTION_KEY_PREVIOUS="…"

# How many proxies (Nginx, a hosting platform, Cloudflare…) sit in front of the app. Used to read the
# visitor's real address for rate limits. 1 for a single proxy; 2 for e.g. Cloudflare in front of Nginx.
TRUSTED_PROXY_HOPS=1
