generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_BANKING
  BANK_TRANSFER
}

enum PaymentStatus {
  POSTED
  REFUNDED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum AppointmentSource {
  DIRECT
  WHATSAPP
  ADMIN
  WALK_IN
}

// What a catalog row is: a lab TEST, a PANEL (package of tests), or any other SERVICE (e.g. home collection).
enum CatalogItemKind {
  SERVICE
  TEST
  PANEL
}

enum ReferenceSex {
  ANY
  MALE
  FEMALE
}

enum PatientSex {
  MALE
  FEMALE
  OTHER
}

// The lab workflow of an order, in order. Steps up to RECEIVED are driven by sample handling;
// the rest belong to result entry and reporting.
enum TestOrderStatus {
  ORDERED
  SAMPLE_COLLECTED
  RECEIVED
  IN_PROCESS
  RESULT_ENTERED
  VERIFIED
  DELIVERED
  CANCELLED
}

enum OrderPriority {
  ROUTINE
  URGENT
}

enum SampleStatus {
  PENDING
  COLLECTED
  RECEIVED
  REJECTED
}

// Where one test of an order stands in the lab. PENDING also covers "sent back for correction".
enum ResultStatus {
  PENDING
  ENTERED
  VERIFIED
}

// How a result compares with its reference range. No flag means no range applied to this patient.
enum ResultFlag {
  NORMAL
  LOW
  HIGH
  CRITICAL_LOW
  CRITICAL_HIGH
  ABNORMAL
}

enum ReportStatus {
  ISSUED
  WITHDRAWN
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SUPPLIES
  LAB_FEES
  EQUIPMENT
  SALARY
  MARKETING
  MAINTENANCE
  OTHER
}

// PURCHASE adds a batch, ISSUE is stock used in the clinic, ADJUSTMENT is a manual correction
// (positive or negative) such as a stock-take difference, damage or expiry write-off.
enum StockMovementType {
  PURCHASE
  ISSUE
  ADJUSTMENT
}

enum QrLoginStatus {
  WAITING
  SCANNED
  APPROVED
  EXPIRED
  CANCELLED
  CONSUMED
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user")
  // A deactivated account keeps its history but can no longer sign in or use any session.
  isActive      Boolean   @default(true)
  // Mobile number of the staff member (digits as typed, spaces and dashes removed).
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  auditEvents AuditEvent[]
  qrLoginSessions QrLoginSession[]
  expenses Expense[]
  stockMovements StockMovement[]
  stockPurchases StockPurchase[]
  cashClosings CashClosing[]
  passwordResetOtps PasswordResetOtp[]
  passwordResetAuthorizations PasswordResetAuthorization[]
  emailAuditLogs EmailAuditLog[]
  smsLogs SmsLog[]

  @@map("user")
}

model QrLoginSession {
  id                 String        @id @default(cuid())
  tokenHash          String        @unique
  desktopProofHash   String
  desktopCookieName  String        @unique
  status             QrLoginStatus @default(WAITING)
  userId             String?
  user               User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  expiresAt          DateTime
  scannedAt          DateTime?
  approvedAt         DateTime?
  cancelledAt        DateTime?
  consumedAt         DateTime?
  createdAt          DateTime      @default(now())

  @@index([status, expiresAt])
  @@index([userId, createdAt])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Appointment {
  id           String            @id @default(cuid())
  patientId    String?
  patient      Patient?           @relation(fields: [patientId], references: [id], onDelete: SetNull)
  patientName  String
  patientPhone String
  patientEmail String?
  service      String
  dateTime     DateTime
  status       AppointmentStatus @default(PENDING)
  source       AppointmentSource @default(DIRECT)
  durationMinutes Int            @default(30)
  serviceId    String?
  clinicService ClinicService?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  doctorId     String?
  doctor       DoctorProfile?    @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  notes        String?           @db.Text
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([dateTime])
  @@index([status, dateTime])
  @@index([patientId, dateTime])
  @@index([serviceId])
  @@index([doctorId, dateTime])
  @@index([source, dateTime])
  @@index([patientName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Appointment_patientName_trgm_idx")
  @@index([patientPhone(ops: raw("gin_trgm_ops"))], type: Gin, map: "Appointment_patientPhone_trgm_idx")
  @@index([service(ops: raw("gin_trgm_ops"))], type: Gin, map: "Appointment_service_trgm_idx")
  @@index([id(ops: raw("gin_trgm_ops"))], type: Gin, map: "Appointment_id_trgm_idx")
}

model Patient {
  id                    String        @id @default(cuid())
  patientCode           String        @unique
  name                  String
  phone                 String
  isActive              Boolean       @default(true)
  email                 String?
  dateOfBirth           DateTime?     @db.Date
  // Reference ranges can depend on sex, so the lab needs it. Optional for existing patients.
  sex                   PatientSex?
  address               String?       @db.Text
  emergencyContactName  String?
  emergencyContactPhone String?
  medicalHistory        String?       @db.Text
  allergies             String?       @db.Text
  notes                 String?       @db.Text
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  appointments          Appointment[]
  invoices              Invoice[]
  reviews               ClinicReview[]
  testOrders            TestOrder[]

  @@index([phone])
  @@index([name])
  @@index([createdAt(sort: Desc), id])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Patient_name_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "Patient_phone_trgm_idx")
  @@index([patientCode(ops: raw("gin_trgm_ops"))], type: Gin, map: "Patient_patientCode_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Patient_email_trgm_idx")
}

// The clinic's doctors. The row with id "primary" is the original single-doctor profile: its weekly
// schedule drives appointment availability and its contact details are the report letterhead, so it
// can be hidden but never deleted. Any other row is a directory-only profile for the public website.
model DoctorProfile {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  designation        String?
  imageUrl           String?
  qualifications     String   @default("")
  specialization     String   @default("Pathology")
  experienceYears    Int?
  registrationNumber String?
  consultationFee    Decimal  @default(0) @db.Decimal(12, 2)
  consultationInfo   String?  @db.Text
  phone              String?
  email              String?
  address            String?  @db.Text
  bio                String?  @db.Text
  displayOrder       Int      @default(0)
  // Hidden from every public page and API when false. A doctor appears publicly only when both flags are true.
  isActive           Boolean  @default(true)
  isPublished        Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  schedules          DoctorSchedule[]
  appointments       Appointment[]

  @@index([isActive, isPublished, displayOrder, name])
  @@index([specialization])
}

model DoctorSchedule {
  id        String       @id @default(cuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  isWorking Boolean      @default(true)

  @@unique([doctorId, dayOfWeek])
}

model ClinicService {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String   @unique
  category        String   @default("General")
  description     String?  @db.Text
  // Optional Bangla text for the bilingual public website.
  nameBn          String?
  descriptionBn   String?  @db.Text
  // Public website presentation. Every field is optional; empty means "show the simple card".
  categoryBn      String?
  iconKey         String?
  badgeEn         String?
  badgeBn         String?
  timeTextEn      String?
  timeTextBn      String?
  painTextEn      String?
  painTextBn      String?
  feeMax          Decimal? @db.Decimal(12, 2)
  detailsEn       String   @default("") @db.Text
  detailsBn       String   @default("") @db.Text
  stepsEn         String[] @default([])
  stepsBn         String[] @default([])
  standardPrice   Decimal  @default(0) @db.Decimal(12, 2)
  durationMinutes Int      @default(30)
  isActive        Boolean  @default(true)
  // Diagnostic catalog. kind decides which of these apply: a TEST has a sample, a turnaround and
  // result parameters; a PANEL is a named bundle of tests; a SERVICE is anything else (e.g. home collection).
  kind            CatalogItemKind @default(SERVICE)
  sampleType      String?
  turnaroundHours Int?
  fastingRequired Boolean  @default(false)
  preparation     String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  appointments    Appointment[]
  invoiceItems    InvoiceItem[]
  parameters      TestParameter[]
  orderItems      TestOrderItem[] @relation("OrderItemTest")
  panelOrderItems TestOrderItem[] @relation("OrderItemPanel")
  panelMembers    TestPanelItem[] @relation("PanelMembers")
  memberOfPanels  TestPanelItem[] @relation("MemberOfPanels")

  @@index([category, isActive])
  @@index([kind, isActive])
}

// One measured value of a test (e.g. Haemoglobin, g/dL). The result entry screen is built from these.
model TestParameter {
  id        String   @id @default(cuid())
  testId    String
  name      String
  unit      String?
  sortOrder Int      @default(0)
  test      ClinicService @relation(fields: [testId], references: [id], onDelete: Cascade)
  ranges    TestReferenceRange[]

  @@unique([testId, name])
  @@index([testId, sortOrder])
}

// Normal range for a parameter, optionally for one sex and age band. The most specific matching row wins.
// low/high are the normal limits; criticalLow/criticalHigh flag results that need a phone call.
model TestReferenceRange {
  id           String   @id @default(cuid())
  parameterId  String
  sex          ReferenceSex @default(ANY)
  minAgeYears  Decimal? @db.Decimal(6, 2)
  maxAgeYears  Decimal? @db.Decimal(6, 2)
  low          Decimal? @db.Decimal(14, 4)
  high         Decimal? @db.Decimal(14, 4)
  criticalLow  Decimal? @db.Decimal(14, 4)
  criticalHigh Decimal? @db.Decimal(14, 4)
  // Free text for non-numeric normals, e.g. "Negative" or "Not detected".
  note         String?
  parameter    TestParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  @@index([parameterId])
}

// Which tests a PANEL (package) contains.
model TestPanelItem {
  panelId String
  testId  String
  panel   ClinicService @relation("PanelMembers", fields: [panelId], references: [id], onDelete: Cascade)
  test    ClinicService @relation("MemberOfPanels", fields: [testId], references: [id], onDelete: Restrict)

  @@id([panelId, testId])
  @@index([testId])
}

// Editable text and images of the public website. One row (id "primary"), like DoctorProfile.
// An empty text means "use the built-in wording", so a new or half-filled row never leaves a gap.
model ClinicContent {
  id                 String   @id @default("primary")
  clinicName         String   @default("")
  clinicSubtitle     String   @default("")
  heroTitleEn        String   @default("")
  heroTitleBn        String   @default("")
  heroSubtitleEn     String   @default("") @db.Text
  heroSubtitleBn     String   @default("") @db.Text
  technologyEn       String   @default("") @db.Text
  technologyBn       String   @default("") @db.Text
  bookingNoteEn      String   @default("") @db.Text
  bookingNoteBn      String   @default("") @db.Text
  closingMessageEn   String   @default("") @db.Text
  closingMessageBn   String   @default("") @db.Text
  doctorHighlightsEn String[] @default([])
  doctorHighlightsBn String[] @default([])
  heroImageUrl       String?
  doctorImageUrl     String?
  // The centre's own introduction (About section): text, key facts one per item, photo.
  centreAboutEn      String   @default("") @db.Text
  centreAboutBn      String   @default("") @db.Text
  centreFactsEn      String[] @default([])
  centreFactsBn      String[] @default([])
  centreImageUrl     String?
  // Menu labels, section headings, feature cards, footer: overrides only (see website-layout.ts).
  layout             Json?
  updatedAt          DateTime @updatedAt
}

model ClinicReview {
  id        String       @id @default(cuid())
  name      String
  rating    Int
  comment   String       @db.Text
  status    ReviewStatus @default(PENDING)
  // The registered patient who wrote it. The mobile number used to check this is never stored here.
  // Reviews written before this check existed have no patient.
  patientId String?
  patient   Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([patientId])
}

model ClinicGalleryImage {
  id        String   @id @default(cuid())
  url       String   @db.Text
  altText   String   @db.VarChar(240)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder, createdAt])
}

model Invoice {
  id          String        @id @default(cuid())
  invoiceCode String        @unique
  patientId   String
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  status      InvoiceStatus @default(ISSUED)
  subtotal    Decimal       @db.Decimal(12, 2)
  discount    Decimal       @default(0) @db.Decimal(12, 2)
  tax         Decimal       @default(0) @db.Decimal(12, 2)
  notes       String?       @db.Text
  issuedAt    DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       InvoiceItem[]
  payments    Payment[]
  testOrder   TestOrder?

  @@index([patientId, issuedAt])
  @@index([status, issuedAt])
  @@index([issuedAt(sort: Desc), id(sort: Desc)])
}

model InvoiceItem {
  id          String        @id @default(cuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  serviceId   String?
  service     ClinicService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  description String
  quantity    Int           @default(1)
  unitPrice   Decimal       @db.Decimal(12, 2)
  amount      Decimal       @db.Decimal(12, 2)

  @@index([invoiceId])
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  reference   String?
  status      PaymentStatus @default(POSTED)
  receivedAt  DateTime      @default(now())
  refundedAt  DateTime?
  note        String?       @db.Text

  @@index([invoiceId, receivedAt])
  @@index([status, receivedAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  entity      String
  entityId    String?
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt(sort: Desc)])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Clinic operating expense. Voided (not deleted) so financial history stays reconstructable.
model Expense {
  id          String          @id @default(cuid())
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(12, 2)
  spentAt     DateTime        @db.Date
  method      PaymentMethod   @default(CASH)
  reference   String?
  voidedAt    DateTime?
  voidReason  String?
  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  stockPurchase StockPurchase?

  @@index([spentAt(sort: Desc)])
  @@index([category, spentAt])
}

// ---- Inventory -------------------------------------------------------------------------------

model Supplier {
  id            String   @id @default(cuid())
  name          String   @unique
  contactPerson String?
  phone         String?
  email         String?
  address       String?  @db.Text
  notes         String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  items         InventoryItem[]
  purchases     StockPurchase[]
}

// A laboratory reagent or consumable. `quantity` is the on-hand total and always equals the sum of its
// batches' remaining quantities; it is only changed together with a StockMovement, in one transaction.
model InventoryItem {
  id           String   @id @default(cuid())
  sku          String   @unique
  name         String   @unique
  category     String   @default("Reagents")
  unit         String   @default("pcs")
  quantity     Int      @default(0)
  reorderLevel Int      @default(0)
  // Unit cost of the most recent purchase; used for the stock value shown in reports.
  unitCost     Decimal  @default(0) @db.Decimal(12, 2)
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  notes        String?  @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  batches      StockBatch[]
  movements    StockMovement[]

  @@index([isActive, category])
  @@index([supplierId])
}

// One received lot. Expiry is tracked per lot, and stock is used oldest-expiry first.
model StockBatch {
  id                String        @id @default(cuid())
  itemId            String
  item              InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  purchaseId        String?
  purchase          StockPurchase? @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  batchNumber       String?
  expiryDate        DateTime?     @db.Date
  quantityReceived  Int
  quantityRemaining Int
  unitCost          Decimal       @default(0) @db.Decimal(12, 2)
  receivedAt        DateTime      @default(now())
  movements         StockMovement[]

  @@index([itemId, quantityRemaining])
  @@index([expiryDate])
  @@index([purchaseId])
}

// Every change of stock, signed (+ in, - out). Never edited or deleted.
model StockMovement {
  id          String            @id @default(cuid())
  itemId      String
  item        InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batchId     String?
  batch       StockBatch?       @relation(fields: [batchId], references: [id], onDelete: Restrict)
  type        StockMovementType
  quantity    Int
  unitCost    Decimal?          @db.Decimal(12, 2)
  reason      String?
  createdById String?
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@index([itemId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([type, createdAt])
}

model StockPurchase {
  id            String   @id @default(cuid())
  purchaseCode  String   @unique
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  invoiceNumber String?
  purchasedAt   DateTime @db.Date
  totalCost     Decimal  @db.Decimal(12, 2)
  note          String?  @db.Text
  // The expense entry created with the purchase (when the clinic paid at purchase time).
  expenseId     String?  @unique
  expense       Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  batches       StockBatch[]

  @@index([purchasedAt(sort: Desc)])
  @@index([supplierId])
}

// ---- Daily cash closing ----------------------------------------------------------------------

// The end-of-day cash count. One row per clinic day. The figures are a snapshot taken at closing so
// the record stays the same even if entries are voided afterwards.
model CashClosing {
  id            String   @id @default(cuid())
  businessDate  DateTime @unique @db.Date
  openingCash   Decimal  @db.Decimal(12, 2)
  cashReceived  Decimal  @db.Decimal(12, 2)
  cashRefunded  Decimal  @db.Decimal(12, 2)
  cashExpenses  Decimal  @db.Decimal(12, 2)
  expectedCash  Decimal  @db.Decimal(12, 2)
  countedCash   Decimal  @db.Decimal(12, 2)
  difference    Decimal  @db.Decimal(12, 2)
  note          String?  @db.Text
  closedById    String?
  closedBy      User?    @relation(fields: [closedById], references: [id], onDelete: SetNull)
  closedAt      DateTime @default(now())

  @@index([businessDate(sort: Desc)])
}

// ---- Roles and permissions -------------------------------------------------------------------

// A named set of permissions. `key` is what user.role stores. The built-in roles (admin,
// receptionist, doctor, assistant, accountant) are created on first use with sensible defaults and
// can be re-configured, except "admin", which always holds every permission.
model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String   @unique
  description String   @default("")
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---- Email and password recovery -------------------------------------------------------------

enum EmailAuthMethod {
  APP_PASSWORD
  PASSWORD
}

// Outgoing mail settings. One row (id "primary"). The SMTP password is stored only as
// AES-256-GCM ciphertext (key kept in the environment, never in the database) and is never
// returned by any API; `passwordSet` is all the screen gets to see.
model EmailConfiguration {
  id                String          @id @default("primary")
  provider          String          @default("gmail")
  host              String          @default("smtp.gmail.com")
  port              Int             @default(465)
  secure            Boolean         @default(true)
  authMethod        EmailAuthMethod @default(APP_PASSWORD)
  username          String          @default("")
  encryptedPassword String?
  senderEmail       String          @default("")
  senderName        String          @default("ASDC Diagnostic")
  enabled           Boolean         @default(false)
  // Result of the last connection test or test e-mail. Cleared whenever the connection settings change.
  lastTestAt        DateTime?
  lastTestStatus    String?
  lastTestMessage   String?
  updatedById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

// A one-time password sent by e-mail. Only an HMAC of the code is stored, never the code.
model PasswordResetOtp {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email         String
  codeHash      String
  expiresAt     DateTime
  attempts      Int       @default(0)
  consumedAt    DateTime?
  invalidatedAt DateTime?
  ipAddress     String?
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([email, createdAt(sort: Desc)])
  @@index([expiresAt])
}

// Proof that an OTP was verified. Short-lived and single-use; only a hash of the token is stored.
model PasswordResetAuthorization {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpId      String    @unique
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// What happened to e-mail settings and e-mail sending. Addresses are masked; codes and passwords never appear.
model EmailAuditLog {
  id        String   @id @default(cuid())
  action    String
  status    String
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  recipient String?
  message   String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([action, createdAt])
}

// ---- SMS (appointment notifications) ---------------------------------------------------------

// SMS gateway settings. One row (id "primary"). The API key is stored only as AES-256-GCM ciphertext
// (same key as the SMTP password, kept in the environment) and is never returned by any API.
model SmsConfiguration {
  id                  String   @id @default("primary")
  provider            String   @default("bulksmsbd")
  encryptedApiKey     String?
  senderId            String   @default("")
  enabled             Boolean  @default(false)
  // Text sent when an appointment is booked. Placeholders: {name} {date} {time} {clinic}.
  appointmentTemplate String   @default("")
  // Abuse and cost guards: SMS per phone number per day, and in total per day.
  perNumberDailyLimit Int      @default(3)
  dailyLimit          Int      @default(200)
  lastTestAt          DateTime?
  lastTestStatus      String?
  lastTestMessage     String?
  updatedById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Every SMS attempt and settings change. The phone number is masked for display and hashed for
// counting; the full number and the message text are not stored.
model SmsLog {
  id            String   @id @default(cuid())
  purpose       String
  status        String
  recipient     String?
  recipientHash String?
  providerCode  String?
  message       String?
  appointmentId String?
  actorId       String?
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([appointmentId])
}

// A lab order: which tests were requested for a patient, the samples they need, and the invoice
// that bills them. Orders are never deleted; a mistaken one is cancelled with a reason.
model TestOrder {
  id            String          @id @default(cuid())
  orderCode     String          @unique
  patientId     String
  patient       Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  invoiceId     String?         @unique
  invoice       Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  status        TestOrderStatus @default(ORDERED)
  priority      OrderPriority   @default(ROUTINE)
  // Free text: the referring doctor or hospital, as written on the request slip.
  referredBy    String?
  clinicalNotes String?         @db.Text
  cancelReason  String?
  cancelledAt   DateTime?
  orderedAt     DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  items         TestOrderItem[]
  samples       Sample[]
  reports       LabReport[]

  @@index([patientId, orderedAt])
  @@index([status, orderedAt])
  @@index([orderedAt(sort: Desc), id(sort: Desc)])
}

// One test to perform. A panel is expanded into its member tests (panelId says which panel).
// Name, code and sample type are copied here so a later catalog edit never rewrites an old order.
model TestOrderItem {
  id         String         @id @default(cuid())
  orderId    String
  order      TestOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  testId     String
  test       ClinicService  @relation("OrderItemTest", fields: [testId], references: [id], onDelete: Restrict)
  panelId    String?
  panel      ClinicService? @relation("OrderItemPanel", fields: [panelId], references: [id], onDelete: Restrict)
  sampleId   String?
  sample     Sample?        @relation(fields: [sampleId], references: [id], onDelete: SetNull)
  testCode   String
  testName   String
  sampleType String?
  // Result entry and approval. A verified item is locked; the pathologist can send it back with a reason.
  resultStatus ResultStatus @default(PENDING)
  // Free-text result, for a test that has no parameters (e.g. a reading or an interpretation).
  resultText   String?      @db.Text
  resultNote   String?      @db.Text
  returnReason String?
  enteredBy    String?
  enteredAt    DateTime?
  verifiedBy   String?
  verifiedAt   DateTime?
  results      TestResult[]

  @@unique([orderId, testId])
  @@index([sampleId])
  @@index([testId])
  @@index([resultStatus])
}

// One measured value. Name, unit and the reference range text are copied here when the result is
// saved, so editing the catalog later never changes a report that was already issued.
model TestResult {
  id            String         @id @default(cuid())
  itemId        String
  item          TestOrderItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  parameterName String
  unit          String?
  sortOrder     Int            @default(0)
  // Exactly what was typed (e.g. "13.2" or "Positive")...
  value         String
  // ...and the number it was read as, when it is one.
  numericValue  Decimal?       @db.Decimal(18, 6)
  flag          ResultFlag?
  referenceText String?

  @@unique([itemId, parameterName])
  @@index([itemId, sortOrder])
}

// One physical specimen (a tube or container) with its own barcode. Tests that need the same
// sample type share one Sample. A rejected sample is replaced by a new PENDING one (replacesId).
model Sample {
  id           String        @id @default(cuid())
  orderId      String
  order        TestOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sampleCode   String        @unique
  sampleType   String
  status       SampleStatus  @default(PENDING)
  collectedAt  DateTime?
  collectedBy  String?
  receivedAt   DateTime?
  receivedBy   String?
  rejectedAt   DateTime?
  rejectedBy   String?
  rejectReason String?
  replacesId   String?       @unique
  replaces     Sample?       @relation("SampleReplacement", fields: [replacesId], references: [id], onDelete: Restrict)
  replacedBy   Sample?       @relation("SampleReplacement")
  createdAt    DateTime      @default(now())
  items        TestOrderItem[]

  @@index([orderId])
  @@index([status, createdAt])
}

// A report released to the patient. The content is frozen into `snapshot` at release, so a later
// edit to the patient, the catalog or the lab letterhead can never change a report already issued.
// An order has at most one ISSUED report at a time; withdrawing it (with a reason) allows a corrected
// one to be released as the next version.
model LabReport {
  id             String       @id @default(cuid())
  reportCode     String       @unique
  orderId        String
  order          TestOrder    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  version        Int          @default(1)
  status         ReportStatus @default(ISSUED)
  // Secret in the patient's link (/r/<token>). Random and unguessable; the patient also needs a PIN.
  accessToken    String       @unique
  // Printed under the QR code so anyone can check the report is genuine (/verify/<code>). Reveals no results.
  verifyCode     String       @unique
  snapshot       Json
  issuedBy       String
  issuedAt       DateTime     @default(now())
  withdrawnBy    String?
  withdrawnAt    DateTime?
  withdrawReason String?
  smsSentAt      DateTime?
  emailSentAt    DateTime?
  firstViewedAt  DateTime?
  viewCount      Int          @default(0)

  @@unique([orderId, version])
  @@index([orderId, status])
}
